# Runtime-only artifacts (per Swinger_Build_Plan_v1.md 4a) -- not source.
calibration.json

__pycache__/
*.pyc

# Superseded, scale-suspect capture (see scoring.py / primer.md) -- kept on
# disk for reference but not tracked; swings_fresh.csv/swings_counted.csv
# are the current real captures code comments reference.
src/swings.csv

# Machine-specific shortcut to the real primer.md (now committed at repo
# root); the .lnk only resolves on the machine that created it.
primer.md.lnk

# Unity CLI batchmode log files (project setup logs, not source)
UnitySwinger_*.log

# Per-run diagnostic logs/snapshots from research/live_*.py -- auto-written
# every run (feedback, 2026-07-29), not meaningful named data like
# research/captures/ which is committed deliberately.
research/logs/
research/hand_tracking_web/logs/

# Raw Mixamo FBX downloads (Adobe terms: ship inside the game, don't
# redistribute the raw files). Only converted game-ready .glb is committed.
Mixamo/

# Blender build scratch output (tools/assets/blender/) — only the .glb a
# build script copies into web/src/assets/ is committed, never the throwaway
# export a script writes next to itself while iterating.
tools/assets/blender/*.glb
tools/assets/blender/*.blend1

# web build + deps
web/node_modules/
web/dist/
node_modules/
runs/
web/dist*

# local leaderboard config + Cloudflare Worker dev state -- never commit
# the deployed Worker URL/secrets or wrangler's local cache
web/.env.local
worker/.wrangler/
worker/node_modules/
