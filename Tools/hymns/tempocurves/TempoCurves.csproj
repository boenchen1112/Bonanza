<Project Sdk="Microsoft.NET.Sdk">
  <!-- Writes the Finale Fever tempo curve dump of each hymn x level from the game's own Core code (TempoExcerpt + TempoCurve):
       dotnet run with the project Tools/hymns/tempocurves, args: hymns dir, out dir, optional hymn list. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>Bonanza.Hymns</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/Game/Core/**/*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
