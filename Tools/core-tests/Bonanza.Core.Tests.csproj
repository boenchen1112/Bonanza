<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the pure-C# EditMode tests without Unity: `dotnet test Tools/core-tests`. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>Bonanza.Core.Tests</RootNamespace>
    <NoWarn>CS0618;CS0162;CS0219;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Game/Core/**/*.cs" />
    <Compile Include="../../Assets/Tests/EditMode/**/*.cs" />
    <Compile Include="UnityShim.cs" />
    <!-- Tests that need the Unity player (assets, PlayerPrefs, Resources): run in Unity. -->
    <Compile Remove="../../Assets/Tests/EditMode/MusicTests.cs" />
    <Compile Remove="../../Assets/Tests/EditMode/SfxTests.cs" />
    <Compile Remove="../../Assets/Tests/EditMode/VoiceTests.cs" />
    <Compile Remove="../../Assets/Tests/EditMode/SettingsTests.cs" />
    <Compile Remove="../../Assets/Tests/EditMode/ShellTests.cs" />
    <Compile Remove="../../Assets/Tests/EditMode/TitleReelTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
